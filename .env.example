# ------------------------------------------------------------------ Discord
# Developer Portal > your app > Bot > Reset Token
DISCORD_BOT_TOKEN=
# Developer Portal > your app > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a redirect added under OAuth2 > Redirects exactly
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Your Discord user ID(s), comma separated. Unlocks the System page (backups, errors).
BOT_OWNER_IDS=
# Optional: a test server ID. Slash commands sync there instantly instead of globally.
DEV_GUILD_ID=

# ------------------------------------------------------------------ Website
WEB_HOST=127.0.0.1
WEB_PORT=8000
# The address people use to reach the dashboard (used in links the bot sends)
PUBLIC_URL=http://localhost:8000
# Long random string. install.bat generates one. Changing it logs everyone out.
SESSION_SECRET=
# Set to true when serving over HTTPS (turned on automatically when PUBLIC_URL starts with https://)
SECURE_COOKIES=false
# Optional link shown on the Support page
SUPPORT_URL=

# ------------------------------------------------------------------ Storage
# DATABASE_PATH=data/nexora.db
# BACKUP_DIR=data/backups

# --------------------------------------------------------- AI (optional, paid)
# Enables /ask. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Spending limits for /ask (it uses YOUR key). 0 = no limit, which isn't recommended for a public bot.
AI_DAILY_LIMIT=300
AI_GUILD_DAILY_LIMIT=30
# Optional: comma-separated server IDs allowed to use /ask. Empty = any server that enables it.
AI_ALLOWED_GUILDS=

LOG_LEVEL=INFO
